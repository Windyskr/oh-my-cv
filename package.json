{
  "name": "oh-my-cv",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "start": "node scripts/start-auth.mjs",
    "build:local": "node scripts/start-local.mjs --build-only",
    "export:pdf": "node scripts/export-cloud-pdf.mjs",
    "build": "pnpm --filter=site build",
    "build:cloudflare": "RESUME_CLOUD_BUILD=1 node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "pnpm build:cloudflare && pnpm dlx wrangler@4.151.1 d1 migrations apply DB --remote && pnpm dlx wrangler@4.151.1 deploy",
    "build:pkg": "pnpm -r --stream build:pkg",
    "build-fast:pkg": "pnpm -r --stream build-fast:pkg",
    "dev": "node scripts/start-auth.mjs",
    "lint": "eslint .",
    "release": "pnpm build:pkg && pnpm build",
    "release:pkg": "pnpm release:pkg:check && pnpm release:pkg:version && pnpm -r publish",
    "release:pkg:check": "pnpm lint && pnpm build:pkg",
    "release:pkg:version": "bumpp package.json packages/*/package.json --commit \"build: publish v%s\" --all --tag --push",
    "serve": "pnpm --filter=site serve",
    "cloud:migrate": "pnpm dlx wrangler@4.151.1 d1 migrations apply DB --remote"
  },
  "prettier": "@renovamen/prettier-config",
  "devDependencies": {
    "@renovamen/eslint-config": "^0.1.7",
    "@renovamen/prettier-config": "^0.1.7",
    "bumpp": "^9.4.1",
    "eslint": "^9.6.0",
    "pnpm": "^9.4.0",
    "prettier": "^3.3.2",
    "taze": "^0.14.2",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "9"
      }
    }
  }
}
